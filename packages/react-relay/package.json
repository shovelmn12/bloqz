{
  "name": "@bloqz/react-relay",
  "version": "2.0.2",
  "description": "React bindings for the @bloqz/relay package.",
  "keywords": [
    "bloc",
    "bloqz",
    "state management",
    "functional",
    "rxjs",
    "typescript",
    "react",
    "relay",
    "event bus"
  ],
  "homepage": "https://github.com/shovelmn12/bloqz#readme",
  "bugs": {
    "url": "https://github.com/shovelmn12/bloqz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shovelmn12/bloqz.git"
  },
  "license": "MIT",
  "author": "Shovel Maman",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "@bloqz/relay": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  }
}
